{
  "name": "earloft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute podcasty --local --file=worker/schema.sql",
    "db:remote": "wrangler d1 execute podcasty --remote --file=worker/schema.sql",
    "db:migrate": "wrangler d1 execute podcasty --remote --file=worker/migrations/0002_skipped.sql",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "idb": "^8.0.4",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/dompurify": "^3.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "license": "MIT"
}
